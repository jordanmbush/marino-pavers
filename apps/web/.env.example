# Local dev against a deployed dev stage. Values come from `npx sst deploy --stage dev`
# outputs (url, userPoolClient). Never commit a real .env.
PUBLIC_MEDIA_URL=https://<dev-router-host>.cloudfront.net/media
PUBLIC_API_URL=https://<dev-router-host>.cloudfront.net
PUBLIC_COGNITO_CLIENT_ID=<dev user pool client id>
PUBLIC_AWS_REGION=us-west-1
