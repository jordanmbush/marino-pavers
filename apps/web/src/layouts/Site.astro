---
import Base from "./Base.astro";
import Header from "@/components/site/Header.astro";
import Footer from "@/components/site/Footer.astro";
import type { Locale } from "@/content/locales";
import { i18n } from "@/services/i18n";
import { alternatesOf } from "@/services/locale";

/**
 * Base + the site chrome. Every public page uses this. A page exists in every
 * language at the mirrored path (`/services` ↔ `/es/services`) unless it says
 * otherwise; the head's hreflang links and the header's language switcher
 * both point at those alternates.
 */
type Props = {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  alternates?: Record<Locale, string>;
};

const { alternates = alternatesOf(Astro.url.pathname), ...rest } = Astro.props;
const { t } = i18n(Astro.currentLocale);
---

<Base {...rest} alternates={alternates}>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-60 focus:rounded-tile focus:bg-taupe-900 focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-white"
  >
    {t.skipToContent}
  </a>
  <div class="flex min-h-screen flex-col bg-paper text-taupe-900">
    <Header alternates={alternates} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </div>
</Base>

<script>
  // Scroll-reveal. One observer for every `.reveal` on the page; each element
  // is released once it has been seen, so nothing keeps animating on scroll.
  const targets = document.querySelectorAll<HTMLElement>(".reveal");
  if (!("IntersectionObserver" in window)) {
    targets.forEach((el) => el.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.14, rootMargin: "0px 0px -8% 0px" },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
