---
import "@fontsource-variable/cormorant-garamond/wght.css";
import "@fontsource-variable/cormorant-garamond/wght-italic.css";
import "@/styles/global.css";
import {
  DEFAULT_LOCALE,
  LOCALES,
  OG_LOCALES,
  type Locale,
} from "@/content/locales";
import { serviceAreas, site, socials } from "@/content/site";
import { i18n } from "@/services/i18n";

/**
 * The SEO contract every page signs: a real title, a description, a canonical
 * URL, Open Graph tags, LocalBusiness structured data and — when the page
 * exists in more than one language — hreflang alternates. All in the HTML on
 * disk, because there is no server to add them later.
 */
type Props = {
  title: string;
  description: string;
  /** Keep crawlers out (the admin page). Also drops the page from the sitemap via astro.config. */
  noindex?: boolean;
  /** Extra JSON-LD for the page, merged after the LocalBusiness block. */
  jsonLd?: Record<string, unknown>;
  /** Where this page lives in each language. Omit for single-language pages. */
  alternates?: Record<Locale, string>;
};

const { title, description, noindex = false, jsonLd, alternates } = Astro.props;
const { locale, t } = i18n(Astro.currentLocale);
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(Astro.url.pathname);
const hreflang = alternates && !noindex ? alternates : undefined;

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  founder: { "@type": "Person", name: site.owner },
  telephone: site.phoneHref.replace("tel:", ""),
  email: site.email,
  description: t.description,
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    addressLocality: site.address.locality,
    addressRegion: site.address.state,
    addressCountry: site.address.country,
  },
  areaServed: serviceAreas.map((name) => ({ "@type": "City", name })),
  sameAs: socials.map((network) => network.href),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      hreflang &&
        LOCALES.map((code) => (
          <link
            rel="alternate"
            hreflang={code}
            href={absolute(hreflang[code])}
          />
        ))
    }
    {
      hreflang && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={absolute(hreflang[DEFAULT_LOCALE])}
        />
      )
    }
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbfaf8" />
    <meta name="application-name" content={site.name} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {
      LOCALES.filter((code) => code !== locale).map((code) => (
        <meta property="og:locale:alternate" content={OG_LOCALES[code]} />
      ))
    }
    <meta name="twitter:card" content="summary" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(localBusiness)}
    />
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
