---
import { Droplets, Layers3, ShieldCheck } from "lucide-react";
import Reveal from "@/components/ui/Reveal.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Anatomy from "./Anatomy.astro";

const badges = [
  { Icon: Layers3, label: "Base compacted in lifts" },
  { Icon: Droplets, label: "Drainage graded away from the house" },
  { Icon: ShieldCheck, label: "2-year workmanship warranty" },
];
---

<section class="bg-basalt-900 text-bone">
  <div class="shell py-20 lg:py-28">
    <SectionHeading
      tone="light"
      eyebrow="Built to last"
      title="Anyone can lay pavers. We build the base underneath them."
      lead="A patio is only as good as what you can’t see. Here’s the section most installers cut corners on — and we never do."
    />

    <Reveal class="mt-14">
      <Anatomy />
    </Reveal>

    <div
      class="mt-12 flex flex-wrap gap-x-8 gap-y-4 border-t border-bone/10 pt-8"
    >
      {
        badges.map(({ Icon, label }) => (
          <div class="flex items-center gap-3 text-sm text-sand/80">
            <Icon className="h-5 w-5 text-ochre" strokeWidth={2} />
            {label}
          </div>
        ))
      }
    </div>
  </div>
</section>
