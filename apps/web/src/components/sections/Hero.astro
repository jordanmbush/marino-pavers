---
import Button from "@/components/ui/Button.astro";
import { site } from "@/content/site";
import { i18n } from "@/services/i18n";

/**
 * The business card, enlarged, on the logo's own grid: two by two with the
 * last corner left open. The headline sits top-left, the card's facts
 * top-right, the lead and the one link bottom-left; bottom-right is the
 * missing square. The only motion on the site is these cells settling.
 */
const { t, href } = i18n(Astro.currentLocale);
const hero = t.home.hero;
---

<section
  class="shell grid gap-x-16 gap-y-12 pt-14 pb-20 lg:grid-cols-2 lg:pt-24 lg:pb-32"
>
  <h1
    class="max-w-[14ch] animate-rise text-[3rem] leading-[1.02] text-taupe-950 sm:text-[3.75rem] lg:text-[4.25rem]"
    style="animation-delay: 0ms"
  >
    {hero.title}
  </h1>

  <div
    class="order-3 animate-rise lg:order-none lg:justify-self-end"
    style="animation-delay: 160ms"
  >
    <div class="max-w-sm border-t border-taupe-300 pt-5 lg:w-[22rem]">
      <p class="text-[1.75rem] leading-none text-taupe-950">{site.owner}</p>
      <p class="mt-2 text-base leading-none text-taupe-500">
        {t.contact.ownerTitle}
      </p>
      <ul
        class="mt-6 flex flex-col gap-2 border-t border-taupe-300 pt-5 text-lg leading-snug text-taupe-700"
      >
        <li>{hero.experience}</li>
        <li>{t.contact.region}</li>
        <li>
          <a
            href={site.phoneHref}
            class="text-taupe-950 underline decoration-taupe-300 hover:decoration-taupe-700"
          >
            {site.phoneDisplay}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div
    class="order-2 flex max-w-[34rem] animate-rise flex-col items-start gap-8 lg:order-none"
    style="animation-delay: 80ms"
  >
    <p class="text-xl leading-relaxed text-taupe-700">{hero.lead}</p>
    <Button href={href("/gallery")} size="lg">{hero.cta}</Button>
  </div>
</section>
