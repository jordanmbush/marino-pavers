---
import { Phone } from "lucide-react";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Reveal from "@/components/ui/Reveal.astro";
import { site } from "@/content/site";
import { i18n } from "@/services/i18n";
import { fill } from "@/services/locale";

/** The closing band. Pages may override the headline copy; the contact card is the same everywhere. */
type Props = { eyebrow?: string; title?: string; lead?: string };

const { t } = i18n(Astro.currentLocale);
const {
  eyebrow = t.cta.eyebrow,
  title = t.cta.title,
  lead = t.cta.lead,
} = Astro.props;
---

<section class="relative overflow-hidden bg-basalt-950 text-bone">
  <div class="h-2 w-full herringbone opacity-70"></div>

  <div class="shell grid gap-10 py-20 lg:grid-cols-[1.5fr_1fr] lg:items-center">
    <Reveal class="flex flex-col gap-6">
      <Eyebrow tone="light">{eyebrow}</Eyebrow>
      <h2 class="text-[2rem] leading-[1.05] sm:text-4xl lg:text-[2.9rem]">
        {title}
      </h2>
      <p class="max-w-xl text-base leading-relaxed text-sand/75 sm:text-lg">
        {lead}
      </p>
      <div class="mt-2 flex flex-wrap gap-4">
        <Button href={site.phoneHref} variant="onDark" size="lg">
          <Phone className="h-4 w-4" strokeWidth={2.4} />
          {t.cta.call}
        </Button>
      </div>
    </Reveal>

    <Reveal delay={120}>
      <div
        class="rounded-tile border border-bone/15 bg-basalt-900 p-8 shadow-paver-lg"
      >
        <span class="eyebrow text-sand/50">{t.cta.preferTalk}</span>
        <a
          href={site.phoneHref}
          class="mt-3 block font-display-wide text-3xl font-extrabold text-bone transition-colors hover:text-ochre-light sm:text-[2.1rem]"
        >
          {site.phoneDisplay}
        </a>
        <p class="mt-4 border-t border-bone/10 pt-4 text-sm text-sand/60">
          {fill(t.cta.serving, { region: t.contact.region })}
        </p>
        <div class="mt-6 border-t border-bone/10 pt-6">
          <span class="eyebrow text-sand/50">{t.cta.preferWrite}</span>
          <a
            href={t.contact.emailHref}
            class="mt-3 block font-display-wide text-lg font-extrabold break-all text-bone transition-colors hover:text-ochre-light"
          >
            {site.email}
          </a>
          <p class="mt-3 text-sm text-sand/60">{t.contact.emailNotePhone}</p>
          <p class="mt-2 text-sm text-sand/60">{t.contact.emailNoteReplies}</p>
        </div>
      </div>
    </Reveal>
  </div>
</section>
