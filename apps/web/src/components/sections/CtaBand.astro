---
import { Phone } from "lucide-react";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Reveal from "@/components/ui/Reveal.astro";
import { site } from "@/content/site";
import { i18n } from "@/services/i18n";
import { fill } from "@/services/locale";

/** The closing band. Pages may override the headline copy; the contact card is the same everywhere. */
type Props = { eyebrow?: string; title?: string; lead?: string };

const { t } = i18n(Astro.currentLocale);
const {
  eyebrow = t.cta.eyebrow,
  title = t.cta.title,
  lead = t.cta.lead,
} = Astro.props;
---

<section class="relative overflow-hidden bg-taupe-950 text-white">
  <div class="h-1.5 w-full herringbone opacity-40"></div>

  <div class="shell grid gap-10 py-20 lg:grid-cols-[1.5fr_1fr] lg:items-center">
    <Reveal class="flex flex-col gap-6">
      <Eyebrow tone="light">{eyebrow}</Eyebrow>
      <h2 class="text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-[3.4rem]">
        {title}
      </h2>
      <p
        class="max-w-xl text-base leading-relaxed text-taupe-200/75 sm:text-lg"
      >
        {lead}
      </p>
      <div class="mt-2 flex flex-wrap gap-4">
        <Button href={site.phoneHref} variant="onDark" size="lg">
          <Phone className="h-4 w-4" strokeWidth={2.4} />
          {t.cta.call}
        </Button>
      </div>
    </Reveal>

    <Reveal delay={120}>
      <div
        class="rounded-tile border border-white/10 bg-taupe-900 p-8 shadow-paver-lg"
      >
        <span class="eyebrow text-taupe-300">{t.cta.preferTalk}</span>
        <a
          href={site.phoneHref}
          class="mt-3 block font-display text-4xl font-medium text-white transition-colors hover:text-taupe-300 sm:text-[2.6rem]"
        >
          {site.phoneDisplay}
        </a>
        <p class="mt-4 border-t border-white/10 pt-4 text-sm text-taupe-200/60">
          {fill(t.cta.serving, { region: t.contact.region })}
        </p>
        <div class="mt-6 border-t border-white/10 pt-6">
          <span class="eyebrow text-taupe-300">{t.cta.preferWrite}</span>
          <a
            href={t.contact.emailHref}
            class="mt-3 block font-display text-2xl font-medium break-all text-white transition-colors hover:text-taupe-300"
          >
            {site.email}
          </a>
          <p class="mt-3 text-sm text-taupe-200/60">
            {t.contact.emailNotePhone}
          </p>
          <p class="mt-2 text-sm text-taupe-200/60">
            {t.contact.emailNoteReplies}
          </p>
        </div>
      </div>
    </Reveal>
  </div>
</section>
