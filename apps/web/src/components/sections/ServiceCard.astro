---
import { ArrowUpRight } from "lucide-react";
import Icon from "@/components/ui/Icon.astro";
import type { Service } from "@/services/content";
import { i18n } from "@/services/i18n";

type Props = { service: Service };

const { service } = Astro.props;
const { href } = i18n(Astro.currentLocale);
---

<a
  href={href(`/services#${service.id}`)}
  class="group flex h-full flex-col gap-4 rounded-tile border border-taupe-900/10 bg-white p-7 shadow-seam transition-all duration-200 hover:-translate-y-1 hover:border-taupe-900/25 hover:shadow-paver"
>
  <div class="flex items-center justify-between">
    <span
      class="flex h-12 w-12 items-center justify-center rounded-tile bg-taupe-900 text-white transition-colors group-hover:bg-taupe-700"
    >
      <Icon name={service.icon} class="h-5 w-5" />
    </span>
    <ArrowUpRight
      className="h-5 w-5 text-taupe-900/30 transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-taupe-700"
    />
  </div>
  <div class="flex flex-col gap-1.5">
    <h3 class="text-2xl">{service.title}</h3>
    <p class="eyebrow text-taupe-500">{service.tagline}</p>
  </div>
  <p class="text-sm leading-relaxed text-taupe-900/65">{service.description}</p>
</a>
