---
import type { Faq } from "@/services/content";

/** No-JS accordion on native <details>/<summary>: keyboard-accessible, works before hydration. */
type Props = { items: Faq[] };

const { items } = Astro.props;
---

<div class="border-t border-taupe-200">
  {
    items.map((item) => (
      <details class="group border-b border-taupe-200">
        <summary class="flex cursor-pointer list-none items-baseline justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
          <span class="text-2xl leading-tight text-taupe-950">
            {item.question}
          </span>
          <span
            class="shrink-0 text-2xl leading-none text-taupe-400"
            aria-hidden="true"
          >
            <span class="group-open:hidden">+</span>
            <span class="hidden group-open:inline">−</span>
          </span>
        </summary>
        <p class="max-w-[62ch] pb-6 text-lg leading-relaxed text-taupe-600">
          {item.answer}
        </p>
      </details>
    ))
  }
</div>
