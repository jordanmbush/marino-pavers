---
import { cn } from "@/components/ui/cn";

/**
 * The hero signature: a running-bond field of bevelled pavers with desert
 * tonal variation, generated deterministically at build (no runtime
 * randomness, no JavaScript). The parent tilts it on a perspective so it
 * reads as a finished patio surface receding toward the horizon.
 */
type Props = { class?: string };

const { class: className } = Astro.props;

const VB_W = 900;
const VB_H = 640;
const BRICK_W = 92;
const BRICK_H = 46;
const JOINT = 8; // polymeric-sand joint between pavers
const ROW_STEP = BRICK_H + JOINT;
const COL_STEP = BRICK_W + JOINT;

// Sandstone / travertine tones — the everyday pavers
const TONES = [
  "#C7AB7C",
  "#BB9A64",
  "#D0B98C",
  "#A98B5E",
  "#8F744F",
  "#7A6244",
];

const rows = Math.ceil(VB_H / ROW_STEP) + 2;
const cols = Math.ceil(VB_W / COL_STEP) + 2;
const bricks: Array<{ x: number; y: number; fill: string }> = [];
for (let row = -1; row < rows; row += 1) {
  const offset = row % 2 === 0 ? 0 : -COL_STEP / 2;
  for (let col = -1; col < cols; col += 1) {
    const n = Math.abs(row * 7 + col * 3 + 40); // deterministic seed
    let fill = TONES[n % TONES.length]!;
    if (n % 19 === 0)
      fill = "#A8432B"; // occasional clay accent
    else if (n % 23 === 0) fill = "#3B3228"; // occasional charcoal
    bricks.push({ x: col * COL_STEP + offset, y: row * ROW_STEP, fill });
  }
}
---

<div class={cn("relative h-full w-full overflow-hidden", className)}>
  <div
    class="absolute top-1/2 left-1/2 h-[160%] w-[150%]"
    style="transform: translate(-50%, -50%) perspective(1100px) rotateX(32deg) rotateZ(-2deg); transform-origin: center;"
  >
    <svg
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid slice"
      class="h-full w-full"
      aria-hidden="true"
    >
      <rect width={VB_W} height={VB_H} fill="#5F4C36"></rect>
      {
        bricks.map((b) => (
          <g>
            <rect
              x={b.x}
              y={b.y}
              width={BRICK_W}
              height={BRICK_H}
              rx={2.5}
              fill={b.fill}
            />
            <rect
              x={b.x}
              y={b.y}
              width={BRICK_W}
              height={5}
              rx={2}
              fill="#ffffff"
              opacity={0.28}
            />
            <rect
              x={b.x}
              y={b.y + BRICK_H - 6}
              width={BRICK_W}
              height={6}
              rx={2}
              fill="#000000"
              opacity={0.24}
            />
          </g>
        ))
      }
    </svg>
  </div>

  <div
    class="pointer-events-none absolute inset-0"
    style="background: linear-gradient(to top, rgba(229,217,195,0) 42%, rgba(229,217,195,0.55) 82%, rgba(229,217,195,0.92) 100%);"
  >
  </div>
</div>
