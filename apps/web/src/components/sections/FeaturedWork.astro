---
import { ArrowRight } from "lucide-react";
import { Gallery } from "@/components/gallery/Gallery";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { i18n } from "@/services/i18n";
import { prefetchManifestItems } from "@/services/media";

const { t, href } = i18n(Astro.currentLocale);
const items = await prefetchManifestItems();
---

<section class="bg-paper">
  <div class="shell py-20 lg:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow={t.home.featured.eyebrow}
        title={t.home.featured.title}
        lead={t.home.featured.lead}
      />
      <a
        href={href("/gallery")}
        class="group flex items-center gap-2 eyebrow text-taupe-700 hover:text-taupe-950"
      >
        {t.home.featured.link}
        <ArrowRight
          className="h-4 w-4 transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>

    <div class="mt-14">
      <Gallery client:visible initialItems={items} limit={3} copy={t.gallery} />
    </div>
  </div>
</section>
