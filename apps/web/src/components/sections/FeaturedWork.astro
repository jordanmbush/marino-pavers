---
import { ArrowRight } from "lucide-react";
import { Gallery } from "@/components/gallery/Gallery";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { prefetchManifestItems } from "@/services/media";

const items = await prefetchManifestItems();
---

<section class="bg-sand">
  <div class="shell py-20 lg:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="Recent work"
        title="Built across the Valley."
        lead="A few backyards, driveways, and pool decks we’ve wrapped up lately."
      />
      <a
        href="/our-work"
        class="group flex items-center gap-2 eyebrow text-cherokee hover:text-cherokee-dark"
      >
        View all projects
        <ArrowRight
          className="h-4 w-4 transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>

    <div class="mt-14">
      <Gallery client:visible initialItems={items} limit={3} />
    </div>
  </div>
</section>
