---
import { Gallery } from "@/components/gallery/Gallery";
import Section from "@/components/ui/Section.astro";
import { i18n } from "@/services/i18n";
import { prefetchManifestItems } from "@/services/media";

/** The three newest photos from the client's library, then the way to the rest. */
const { t, href } = i18n(Astro.currentLocale);
const items = await prefetchManifestItems();
---

<Section title={t.home.featured.title} lead={t.home.featured.lead}>
  <Gallery client:visible initialItems={items} limit={3} copy={t.gallery} />
  <a
    href={href("/gallery")}
    class="mt-10 inline-block text-lg text-taupe-700 underline decoration-taupe-300 transition-colors hover:text-taupe-950 hover:decoration-taupe-700"
  >
    {t.home.featured.link}
  </a>
</Section>
