---
import Section from "@/components/ui/Section.astro";
import { getProcess } from "@/services/content";
import { i18n } from "@/services/i18n";

/** The five steps of a job, numbered because they happen in this order. */
const { locale, t } = i18n(Astro.currentLocale);
const steps = await getProcess(locale);
---

<Section {...t.home.process}>
  <ol class="border-t border-taupe-200">
    {
      steps.map((step) => (
        <li class="grid gap-2 border-b border-taupe-200 py-6 sm:grid-cols-[3.5rem_minmax(0,1fr)]">
          <span class="text-2xl leading-tight text-taupe-400">
            {step.order}
          </span>
          <div>
            <h3 class="text-2xl leading-tight text-taupe-950">{step.title}</h3>
            <p class="mt-2 max-w-[60ch] text-lg leading-relaxed text-taupe-600">
              {step.body}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
