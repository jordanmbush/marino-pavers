---
import { Image } from "astro:assets";
import Section from "@/components/ui/Section.astro";
import { getServices } from "@/services/content";
import { i18n } from "@/services/i18n";

/** The six services as one ruled list, each with its photo; a row opens its entry on the services page. */
const { locale, t, href } = i18n(Astro.currentLocale);
const services = await getServices(locale);
---

<Section {...t.home.services}>
  <ul class="border-t border-taupe-200">
    {
      services.map((service) => (
        <li class="border-b border-taupe-200">
          <a
            href={href(`/services#${service.id}`)}
            class="group grid grid-cols-[5.5rem_minmax(0,1fr)] gap-x-5 gap-y-1 py-5 sm:grid-cols-[7rem_minmax(0,1fr)_minmax(0,1.6fr)] sm:gap-x-8"
          >
            <Image
              src={service.image}
              alt=""
              layout="constrained"
              width={224}
              height={168}
              fit="cover"
              class="row-span-2 h-auto w-full rounded-tile sm:row-span-1"
            />
            <h3 class="text-2xl leading-tight text-taupe-950 underline decoration-transparent transition-colors group-hover:decoration-taupe-400">
              {service.title}
            </h3>
            <p class="text-lg leading-relaxed text-taupe-600">
              {service.tagline}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
