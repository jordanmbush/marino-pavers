---
import Section from "@/components/ui/Section.astro";
import { getTestimonials } from "@/services/content";
import { i18n } from "@/services/i18n";

/** Three homeowners in their own words. Quotes are the one place italic appears. */
const { locale, t } = i18n(Astro.currentLocale);
const testimonials = await getTestimonials(locale);
---

<Section title={t.home.testimonials.title}>
  <div class="grid gap-10 md:grid-cols-3 md:gap-8">
    {
      testimonials.map((item) => (
        <figure class="flex flex-col gap-5 border-t border-taupe-200 pt-6">
          <blockquote class="text-[1.375rem] leading-snug text-taupe-950 italic">
            “{item.quote}”
          </blockquote>
          <figcaption class="text-base leading-snug text-taupe-600">
            <span class="block text-lg text-taupe-950">{item.name}</span>
            {item.project}, {item.city}
          </figcaption>
        </figure>
      ))
    }
  </div>
</Section>
