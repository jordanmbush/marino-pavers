---
import Section from "@/components/ui/Section.astro";
import { serviceAreas } from "@/content/site";
import { i18n } from "@/services/i18n";

/** The cities, as a list a reader can scan for their own. */
const { t } = i18n(Astro.currentLocale);
---

<Section {...t.home.area}>
  <ul
    class="columns-2 gap-10 text-xl leading-[1.9] text-taupe-950 sm:columns-3"
  >
    {serviceAreas.map((area) => <li>{area}</li>)}
  </ul>
</Section>
