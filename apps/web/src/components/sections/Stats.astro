---
import Reveal from "@/components/ui/Reveal.astro";
import { stats } from "@/content/site";
---

<section class="bg-basalt-950 text-bone">
  <div class="shell grid grid-cols-2 lg:grid-cols-4">
    {
      stats.map((stat, i) => (
        <Reveal
          delay={i * 80}
          class="flex flex-col gap-2 border-basalt-700/60 px-2 py-10 lg:border-l lg:[&:first-child]:border-l-0 [&:nth-child(n+3)]:border-t lg:[&:nth-child(n+3)]:border-t-0"
        >
          <span class="font-display-wide text-4xl font-extrabold text-bone lg:text-5xl">
            {stat.value}
          </span>
          <span class="eyebrow text-ochre-light">{stat.label}</span>
        </Reveal>
      ))
    }
  </div>
</section>
