---
import Reveal from "@/components/ui/Reveal.astro";
import { i18n } from "@/services/i18n";

const { t } = i18n(Astro.currentLocale);
---

<section class="border-y border-taupe-200 bg-paper">
  <div class="shell grid grid-cols-2 lg:grid-cols-3">
    {
      t.home.stats.map((stat, i) => (
        <Reveal
          delay={i * 80}
          class="flex flex-col gap-2 border-taupe-200 px-2 py-10 lg:border-l lg:[&:first-child]:border-l-0 [&:nth-child(n+3)]:border-t lg:[&:nth-child(n+3)]:border-t-0"
        >
          <span class="font-display text-5xl font-medium text-taupe-900 lg:text-6xl">
            {stat.value}
          </span>
          <span class="eyebrow text-taupe-500">{stat.label}</span>
        </Reveal>
      ))
    }
  </div>
</section>
