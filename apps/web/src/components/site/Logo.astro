---
import { cn } from "@/components/ui/cn";
import { i18n } from "@/services/i18n";

/**
 * Brand mark: three square pavers on a 2×2 grid with the last corner left
 * open — one dark, two light, joints a twentieth of the width. The mark keeps
 * its two greys on light and dark ground; `tone` only recolours the wordmark,
 * set in the display face over a mono locale line. As a link it goes to the
 * home page in the current language.
 */
type Props = { tone?: "dark" | "light"; class?: string; asLink?: boolean };

const { tone = "dark", class: className, asLink = true } = Astro.props;
const { t, href } = i18n(Astro.currentLocale);
/** The mark's two greys. `public/favicon.svg` repeats them. */
const MARK_DARK = "#635956";
const MARK_LIGHT = "#9E9997";
const text = tone === "light" ? "text-bone" : "text-basalt";
const sub = tone === "light" ? "text-sand/60" : "text-basalt/50";
const Wrapper = asLink ? "a" : "span";
const wrapperProps = asLink
  ? { href: href("/"), "aria-label": t.header.logo, class: "inline-flex" }
  : { class: "inline-flex" };
---

<Wrapper {...wrapperProps}>
  <span class={cn("flex items-center gap-3", className)}>
    <svg
      width="36"
      height="36"
      viewBox="0 0 40 40"
      fill="none"
      aria-hidden="true"
      class="shrink-0"
    >
      <rect x="0" y="0" width="19" height="19" fill={MARK_DARK}></rect>
      <rect x="21" y="0" width="19" height="19" fill={MARK_LIGHT}></rect>
      <rect x="0" y="21" width="19" height="19" fill={MARK_LIGHT}></rect>
    </svg>
    <span class="flex flex-col leading-none">
      <span
        class={cn(
          "font-display-wide text-[1.15rem] font-extrabold tracking-[0.02em]",
          text,
        )}
      >
        MARINO
      </span>
      <span class={cn("mt-1 eyebrow text-[0.6rem] tracking-[0.3em]", sub)}
        >Pavers · Phoenix</span
      >
    </span>
  </span>
</Wrapper>
