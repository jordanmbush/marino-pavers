---
import { Mail, MapPin, Phone } from "lucide-react";
import {
  nav,
  serviceAreas,
  site,
  socials,
  type SocialId,
} from "@/content/site";
import { getServices } from "@/services/content";
import { i18n } from "@/services/i18n";
import { fill } from "@/services/locale";
import Logo from "./Logo.astro";

const { locale, t, href } = i18n(Astro.currentLocale);
const services = await getServices(locale);
const year = new Date().getFullYear();
const areas = serviceAreas.slice(0, -1).join(", ");
const lastArea = serviceAreas[serviceAreas.length - 1];
const socialLabel: Record<SocialId, string> = {
  instagram: t.footer.instagram,
  facebook: t.footer.facebook,
};
---

<footer class="mt-auto bg-taupe-950 text-taupe-200">
  <div
    class="shell grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]"
  >
    <div class="flex flex-col gap-5">
      <Logo tone="light" />
      <!-- The card's second line: the owner's name over a hairline. -->
      <div class="flex flex-col gap-3">
        <p class="font-display text-2xl leading-none text-taupe-100">
          {site.owner}
          <span class="ml-2 eyebrow text-taupe-400">{t.contact.ownerTitle}</span
          >
        </p>
        <span class="h-px w-40 bg-taupe-600" aria-hidden="true"></span>
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-taupe-200/65">
        {t.footer.blurb}
      </p>
      <div class="flex gap-3">
        {
          socials.map(({ id, href: url }) => (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={socialLabel[id]}
              class="flex h-10 w-10 items-center justify-center rounded-tile border border-white/15 text-taupe-200/70 transition-colors hover:border-taupe-300 hover:text-white"
            >
              {id === "instagram" ? (
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                </svg>
              ) : (
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <div class="flex flex-col gap-4">
      <h4 class="eyebrow text-taupe-300">{t.footer.services}</h4>
      <ul class="flex flex-col gap-2.5">
        {
          services.map((s) => (
            <li>
              <a
                href={href(`/services#${s.id}`)}
                class="text-sm text-taupe-200/70 transition-colors hover:text-white"
              >
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-4">
      <h4 class="eyebrow text-taupe-300">{t.footer.explore}</h4>
      <ul class="flex flex-col gap-2.5">
        {
          nav.map((item) => (
            <li>
              <a
                href={href(item.href)}
                class="text-sm text-taupe-200/70 transition-colors hover:text-white"
              >
                {t.nav[item.id]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-4">
      <h4 class="eyebrow text-taupe-300">{t.footer.contact}</h4>
      <ul class="flex flex-col gap-3 text-sm text-taupe-200/70">
        <li>
          <a
            href={site.phoneHref}
            class="flex items-center gap-3 transition-colors hover:text-white"
          >
            <Phone className="h-4 w-4 shrink-0 text-taupe-400" />
            {site.phoneDisplay}
          </a>
        </li>
        <li class="flex flex-col gap-1">
          <a
            href={t.contact.emailHref}
            class="flex items-center gap-3 transition-colors hover:text-white"
          >
            <Mail className="h-4 w-4 shrink-0 text-taupe-400" />
            {site.email}
          </a>
          <p class="pl-7 text-xs text-taupe-200/50">
            {t.contact.emailNotePhone}
          </p>
        </li>
        <li class="flex items-center gap-3">
          <MapPin className="h-4 w-4 shrink-0 text-taupe-400" />
          {t.contact.region}
        </li>
      </ul>
    </div>
  </div>

  <div class="shell">
    <p class="border-t border-white/10 py-4 text-xs text-taupe-200/50">
      {fill(t.footer.serving, { areas, last: lastArea })}
    </p>
  </div>

  <div class="border-t border-white/10">
    <div
      class="shell flex flex-col gap-2 py-6 text-xs text-taupe-200/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.legalName}. {t.footer.rights}</p>
    </div>
  </div>
</footer>
