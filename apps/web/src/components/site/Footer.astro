---
import {
  nav,
  serviceAreas,
  site,
  socials,
  type SocialId,
} from "@/content/site";
import { getServices } from "@/services/content";
import { i18n } from "@/services/i18n";
import { fill } from "@/services/locale";
import Logo from "./Logo.astro";
import SocialIcon from "./SocialIcon.astro";

/** The back of the card: the lockup and the owner's line, then the links, all on linen. */
const { locale, t, href } = i18n(Astro.currentLocale);
const services = await getServices(locale);
const year = new Date().getFullYear();
const areas = serviceAreas.slice(0, -1).join(", ");
const lastArea = serviceAreas[serviceAreas.length - 1];
const socialLabel: Record<SocialId, string> = {
  instagram: t.footer.instagram,
  facebook: t.footer.facebook,
};
---

<footer class="mt-auto border-t border-taupe-200 bg-taupe-50 text-taupe-700">
  <div
    class="shell grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1.2fr] lg:py-20"
  >
    <div class="flex flex-col gap-6">
      <Logo />
      <div>
        <p class="text-2xl leading-none text-taupe-950">{site.owner}</p>
        <p class="mt-2 text-base leading-none text-taupe-500">
          {t.contact.ownerTitle}
        </p>
        <span class="mt-5 block h-px w-40 bg-taupe-300" aria-hidden="true"
        ></span>
      </div>
      <p class="max-w-xs text-lg leading-relaxed text-taupe-600">
        {t.footer.blurb}
      </p>
      <ul class="flex gap-4">
        {
          socials.map(({ id, href: url }) => (
            <li>
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={socialLabel[id]}
                class="inline-flex rounded-[6px] transition-opacity hover:opacity-80"
              >
                <SocialIcon id={id} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-4">
      <h4 class="text-base leading-none text-taupe-500">{t.footer.services}</h4>
      <ul class="flex flex-col gap-2">
        {
          services.map((s) => (
            <li>
              <a
                href={href(`/services#${s.id}`)}
                class="text-lg text-taupe-950 hover:underline"
              >
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-4">
      <h4 class="text-base leading-none text-taupe-500">{t.footer.explore}</h4>
      <ul class="flex flex-col gap-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={href(item.href)}
                class="text-lg text-taupe-950 hover:underline"
              >
                {t.nav[item.id]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-4">
      <h4 class="text-base leading-none text-taupe-500">{t.footer.contact}</h4>
      <ul class="flex flex-col gap-3 text-lg">
        <li>
          <a href={site.phoneHref} class="text-taupe-950 hover:underline">
            {site.phoneDisplay}
          </a>
        </li>
        <li>
          <a
            href={t.contact.emailHref}
            class="break-all text-taupe-950 hover:underline"
          >
            {site.email}
          </a>
          <p class="mt-1 text-base leading-snug text-taupe-500">
            {t.contact.emailNotePhone}
          </p>
        </li>
        <li class="text-taupe-700">{t.contact.region}</li>
      </ul>
    </div>
  </div>

  <div class="shell">
    <p class="border-t border-taupe-200 py-5 text-base text-taupe-500">
      {fill(t.footer.serving, { areas, last: lastArea })}
    </p>
    <p class="border-t border-taupe-200 py-5 text-base text-taupe-500">
      © {year}{" "}{site.legalName}.{" "}{t.footer.rights}
    </p>
  </div>
</footer>
