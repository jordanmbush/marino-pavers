---
import { Menu, Phone, X } from "lucide-react";
import { cn } from "@/components/ui/cn";
import type { Locale } from "@/content/locales";
import { nav, site } from "@/content/site";
import { i18n } from "@/services/i18n";
import { splitLocale } from "@/services/locale";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";

type Props = { alternates: Record<Locale, string> };

const { alternates } = Astro.props;
const { t, href } = i18n(Astro.currentLocale);
// Active state compares unprefixed routes, so `/es/services` lights "Servicios".
const { path } = splitLocale(Astro.url.pathname);
const isActive = (route: string) =>
  route === "/" ? path === "/" : path === route || path.startsWith(`${route}/`);
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-taupe-200 bg-paper/95 backdrop-blur-md"
>
  <div
    class="shell flex h-[4.5rem] items-center justify-between gap-4 lg:gap-6"
  >
    <Logo />

    <nav
      class="hidden items-center gap-8 lg:flex"
      aria-label={t.header.primaryNav}
    >
      {
        nav.map((item) => (
          <a
            href={href(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={cn(
              "py-1 text-lg leading-none transition-colors",
              isActive(item.href)
                ? "text-taupe-950 underline decoration-taupe-400 underline-offset-8"
                : "text-taupe-600 hover:text-taupe-950",
            )}
          >
            {t.nav[item.id]}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3 lg:gap-6">
      <a
        href={site.phoneHref}
        class="hidden items-center gap-2 text-lg leading-none text-taupe-600 transition-colors hover:text-taupe-950 lg:flex"
      >
        <Phone className="h-4 w-4" strokeWidth={1.8} />
        {site.phoneDisplay}
      </a>

      <LanguageSwitcher alternates={alternates} />

      <button
        type="button"
        data-menu-toggle
        data-label-open={t.header.openMenu}
        data-label-close={t.header.closeMenu}
        class="flex h-10 w-10 items-center justify-center rounded-tile border border-taupe-300 text-taupe-950 lg:hidden"
        aria-label={t.header.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span data-icon-open
          ><Menu className="h-5 w-5" strokeWidth={1.6} /></span
        >
        <span data-icon-close hidden
          ><X className="h-5 w-5" strokeWidth={1.6} /></span
        >
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    data-menu-drawer
    class="max-h-0 overflow-hidden border-t border-taupe-200 bg-paper transition-[max-height] duration-300 ease-out lg:hidden"
  >
    <div class="shell flex flex-col py-4">
      {
        nav.map((item) => (
          <a
            href={href(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={cn(
              "border-b border-taupe-200 py-4 text-2xl leading-none",
              isActive(item.href) ? "text-taupe-500" : "text-taupe-950",
            )}
          >
            {t.nav[item.id]}
          </a>
        ))
      }
      <a
        href={site.phoneHref}
        class="mt-6 flex items-center gap-2 text-lg text-taupe-700"
      >
        <Phone className="h-4 w-4" strokeWidth={1.8} />
        {site.phoneDisplay}
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const drawer = header?.querySelector<HTMLElement>("[data-menu-drawer]");
  const iconOpen = header?.querySelector<HTMLElement>("[data-icon-open]");
  const iconClose = header?.querySelector<HTMLElement>("[data-icon-close]");

  if (toggle && drawer && iconOpen && iconClose) {
    // The labels are rendered in the page's language; read them off the button.
    const labelOpen = toggle.dataset.labelOpen ?? "Open menu";
    const labelClose = toggle.dataset.labelClose ?? "Close menu";
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? labelClose : labelOpen);
      drawer.classList.toggle("max-h-0", !open);
      drawer.classList.toggle("max-h-[26rem]", open);
      iconOpen.hidden = open;
      iconClose.hidden = !open;
      // Lock body scroll while the drawer is open.
      document.body.style.overflow = open ? "hidden" : "";
    };
    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });
  }
</script>
