---
import { Menu, Phone, X } from "lucide-react";
import { cn } from "@/components/ui/cn";
import type { Locale } from "@/content/locales";
import { nav, site } from "@/content/site";
import { i18n } from "@/services/i18n";
import { splitLocale } from "@/services/locale";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";

type Props = { alternates: Record<Locale, string> };

const { alternates } = Astro.props;
const { t, href } = i18n(Astro.currentLocale);
// Active state compares unprefixed routes, so `/es/services` lights "Servicios".
const { path } = splitLocale(Astro.url.pathname);
const isActive = (route: string) =>
  route === "/" ? path === "/" : path === route || path.startsWith(`${route}/`);
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-basalt/10 bg-sand/85 backdrop-blur-md"
>
  <div
    class="shell flex h-[4.5rem] items-center justify-between gap-4 lg:gap-6"
  >
    <Logo />

    <nav
      class="hidden items-center gap-8 lg:flex"
      aria-label={t.header.primaryNav}
    >
      {
        nav.map((item) => (
          <a
            href={href(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={cn(
              "py-1 eyebrow text-[0.7rem] transition-colors",
              isActive(item.href)
                ? "text-cherokee"
                : "text-basalt/60 hover:text-basalt",
            )}
          >
            {t.nav[item.id]}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3 lg:gap-5">
      <a
        href={site.phoneHref}
        class="hidden items-center gap-2 eyebrow text-[0.7rem] text-basalt/70 transition-colors hover:text-basalt lg:flex"
      >
        <Phone className="h-3.5 w-3.5" strokeWidth={2.4} />
        {site.phoneDisplay}
      </a>

      <LanguageSwitcher alternates={alternates} />

      <button
        type="button"
        data-menu-toggle
        data-label-open={t.header.openMenu}
        data-label-close={t.header.closeMenu}
        class="flex h-10 w-10 items-center justify-center rounded-tile border border-basalt/15 text-basalt lg:hidden"
        aria-label={t.header.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span data-icon-open><Menu className="h-5 w-5" /></span>
        <span data-icon-close hidden><X className="h-5 w-5" /></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    data-menu-drawer
    class="max-h-0 overflow-hidden border-t border-basalt/10 bg-sand transition-[max-height] duration-300 ease-out lg:hidden"
  >
    <div class="shell flex flex-col gap-1 py-4">
      {
        nav.map((item) => (
          <a
            href={href(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={cn(
              "flex items-center justify-between border-b border-basalt/10 py-3 font-display-wide text-lg font-extrabold",
              isActive(item.href) ? "text-cherokee" : "text-basalt",
            )}
          >
            {t.nav[item.id]}
          </a>
        ))
      }
      <div class="mt-4 flex flex-col gap-3">
        <a
          href={site.phoneHref}
          class="flex items-center gap-2 eyebrow text-basalt/70"
        >
          <Phone className="h-4 w-4" strokeWidth={2.4} />
          {site.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const drawer = header?.querySelector<HTMLElement>("[data-menu-drawer]");
  const iconOpen = header?.querySelector<HTMLElement>("[data-icon-open]");
  const iconClose = header?.querySelector<HTMLElement>("[data-icon-close]");

  if (toggle && drawer && iconOpen && iconClose) {
    // The labels are rendered in the page's language; read them off the button.
    const labelOpen = toggle.dataset.labelOpen ?? "Open menu";
    const labelClose = toggle.dataset.labelClose ?? "Close menu";
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? labelClose : labelOpen);
      drawer.classList.toggle("max-h-0", !open);
      drawer.classList.toggle("max-h-[26rem]", open);
      iconOpen.hidden = open;
      iconClose.hidden = !open;
      // Lock body scroll while the drawer is open.
      document.body.style.overflow = open ? "hidden" : "";
    };
    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });
  }
</script>
