---
import { cn } from "./cn";
import Eyebrow from "./Eyebrow.astro";

/**
 * Eyebrow (mono label) + display title + optional lead. `tone="light"`
 * inverts the colours for use on basalt sections.
 */
type Props = {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
  tone?: "dark" | "light";
  class?: string;
};

const {
  eyebrow,
  title,
  lead,
  align = "left",
  tone = "dark",
  class: className,
} = Astro.props;
const onDark = tone === "light";
---

<div
  class={cn(
    "flex max-w-2xl flex-col gap-4",
    align === "center" && "mx-auto items-center text-center",
    className,
  )}
>
  {eyebrow && <Eyebrow tone={tone}>{eyebrow}</Eyebrow>}
  <h2
    class={cn(
      "text-[1.9rem] leading-[1.05] sm:text-4xl lg:text-[2.75rem]",
      onDark ? "text-bone" : "text-basalt",
    )}
  >
    {title}
  </h2>
  {
    lead && (
      <p
        class={cn(
          "text-base leading-relaxed sm:text-lg",
          onDark ? "text-sand/75" : "text-basalt/70",
        )}
      >
        {lead}
      </p>
    )
  }
  <slot />
</div>
