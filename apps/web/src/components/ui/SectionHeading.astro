---
import { cn } from "./cn";
import Eyebrow from "./Eyebrow.astro";

/**
 * Eyebrow (italic label) + Garamond title + the card's hairline + optional
 * lead. `tone="light"` inverts the colours for use on the dark bands.
 */
type Props = {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
  tone?: "dark" | "light";
  class?: string;
};

const {
  eyebrow,
  title,
  lead,
  align = "left",
  tone = "dark",
  class: className,
} = Astro.props;
const onDark = tone === "light";
---

<div
  class={cn(
    "flex max-w-2xl flex-col gap-4",
    align === "center" && "mx-auto items-center text-center",
    className,
  )}
>
  {eyebrow && <Eyebrow tone={tone}>{eyebrow}</Eyebrow>}
  <h2
    class={cn(
      "text-[2.4rem] leading-[1.02] sm:text-5xl lg:text-[3.4rem]",
      onDark ? "text-white" : "text-taupe-900",
    )}
  >
    {title}
  </h2>
  <span
    class={cn("h-px w-14", onDark ? "bg-taupe-300/50" : "bg-taupe-300")}
    aria-hidden="true"></span>
  {
    lead && (
      <p
        class={cn(
          "text-base leading-relaxed sm:text-lg",
          onDark ? "text-taupe-200/75" : "text-taupe-900/70",
        )}
      >
        {lead}
      </p>
    )
  }
  <slot />
</div>
