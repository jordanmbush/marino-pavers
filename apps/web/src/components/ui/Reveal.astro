---
import type { HTMLTag } from "astro/types";
import { cn } from "./cn";

/**
 * Reveals its children as they scroll into view: they start settled a little
 * low and rise into place. The observer lives once in Site.astro; this only
 * marks the element and its stagger delay. Fires once, respects reduced
 * motion (handled in global.css).
 */
type Props = {
  tag?: HTMLTag;
  class?: string;
  /** Stagger in ms — lets a row of cards settle in sequence. */
  delay?: number;
  id?: string;
};

const { tag: Tag = "div", class: className, delay = 0, id } = Astro.props;
---

<Tag
  id={id}
  class={cn("reveal", className)}
  style={`--reveal-delay: ${delay}ms`}
>
  <slot />
</Tag>
