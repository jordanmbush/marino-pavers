---
import { cn } from "./cn";

/**
 * The italic Garamond label above a heading — the card's "Email:" — with an
 * optional hairline before it.
 */
type Props = { tone?: "dark" | "light"; class?: string; rule?: boolean };

const { tone = "dark", class: className, rule = false } = Astro.props;
const onDark = tone === "light";
---

<span
  class={cn(
    "flex items-center gap-3 eyebrow",
    onDark ? "text-taupe-300" : "text-taupe-500",
    className,
  )}
>
  {
    rule && (
      <span
        class={cn("h-px w-8", onDark ? "bg-taupe-300/50" : "bg-taupe-300")}
      />
    )
  }
  <slot />
</span>
