---
import type { IconName } from "@/content/icons";
import { ICONS } from "./icons";

/**
 * A content icon on a static page. Renders the Lucide React component to
 * plain SVG at build — no client directive, so nothing ships to the browser.
 */
type Props = { name: IconName; class?: string; strokeWidth?: number };

const { name, class: className, strokeWidth = 2 } = Astro.props;
const Glyph = ICONS[name];
---

<Glyph className={className} strokeWidth={strokeWidth} aria-hidden="true" />
