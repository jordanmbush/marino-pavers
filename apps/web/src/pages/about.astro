---
import Site from "@/layouts/Site.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import Icon from "@/components/ui/Icon.astro";
import PageHero from "@/components/ui/PageHero.astro";
import Reveal from "@/components/ui/Reveal.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { credentials, site, stats } from "@/content/site";
import { getValues } from "@/services/content";

const values = await getValues();
---

<Site
  title="About — Family-Run Phoenix Paver Crew | Marino Pavers"
  description={`Family-run since ${site.foundedYear}. Marino Pavers still lays its own base, runs its own crew, and backs every Phoenix patio, driveway and turf install with a two-year warranty.`}
>
  <PageHero
    eyebrow="About"
    title="A Phoenix crew that treats your yard like our own."
    lead={`Family-run since ${site.foundedYear}, still laying our own base, still refusing to cut the corners you’d never see.`}
  />

  <section class="bg-sand">
    <div
      class="shell grid gap-12 py-20 lg:grid-cols-[1fr_1fr] lg:gap-20 lg:py-28"
    >
      <Reveal class="flex flex-col gap-5">
        <SectionHeading
          eyebrow="Our story"
          title="Started over one cracked patio too many."
        />
        <div class="flex flex-col gap-4 leading-relaxed text-basalt/75">
          <p>
            Marino Pavers started in {site.foundedYear} with one truck, a plate compactor,
            and a simple frustration: too many Valley homeowners were paying for patios
            that cracked, heaved, or washed out after the first monsoon — because
            the crew before us skipped the base.
          </p>
          <p>
            We’d spent years on commercial hardscape crews, where the base work
            is non-negotiable, and brought that same standard home to
            residential driveways and backyards. The finish is what you see; the
            base is why it lasts.
          </p>
          <p>
            More than a decade and 600-plus projects later, we’re still
            family-run, still compacting every base in lifts, and still showing
            up with the same crew that shook your hand at the quote.
          </p>
        </div>
      </Reveal>

      <Reveal
        delay={120}
        class="grid grid-cols-2 gap-4 self-start rounded-tile border border-basalt/10 bg-bone p-8 shadow-paver"
      >
        {
          stats.map((stat) => (
            <div class="flex flex-col gap-1 py-3">
              <span class="font-display-wide text-3xl font-extrabold text-basalt">
                {stat.value}
              </span>
              <span class="eyebrow text-cherokee">{stat.label}</span>
            </div>
          ))
        }
      </Reveal>
    </div>
  </section>

  <section class="bg-basalt-950 text-bone">
    <div class="shell py-20 lg:py-28">
      <SectionHeading
        tone="light"
        eyebrow="How we work"
        title="Four things we won’t compromise on."
      />
      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {
          values.map((value, i) => (
            <Reveal delay={(i % 2) * 100}>
              <div class="flex h-full gap-5 rounded-tile border border-bone/10 bg-basalt-900 p-8">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-tile bg-cherokee text-bone">
                  <Icon name={value.icon} class="h-5 w-5" />
                </span>
                <div class="flex flex-col gap-2">
                  <h3 class="text-xl text-bone">{value.title}</h3>
                  <p class="text-sm leading-relaxed text-sand/70">
                    {value.body}
                  </p>
                </div>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-sand-light">
    <div
      class="shell flex flex-wrap items-center justify-center gap-x-12 gap-y-5 py-12"
    >
      {
        credentials.map((c) => (
          <div class="flex items-center gap-3 text-sm font-bold text-basalt/75">
            <Icon name={c.icon} class="h-5 w-5 text-cherokee" />
            {c.label}
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand />
</Site>
