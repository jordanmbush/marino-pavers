---
import Site from "@/layouts/Site.astro";
import { Gallery } from "@/components/gallery/Gallery";
import Contact from "@/components/sections/Contact.astro";
import PageIntro from "@/components/ui/PageIntro.astro";
import { i18n } from "@/services/i18n";
import { localeParams } from "@/services/locale";
import { prefetchManifestItems } from "@/services/media";

/** Builds `/gallery` and `/es/gallery`; see `[...locale]/index.astro`. */
export const getStaticPaths = () => localeParams();

const { t } = i18n(Astro.currentLocale);
const page = t.galleryPage;
const items = await prefetchManifestItems();
---

<Site title={page.title} description={page.description}>
  <PageIntro {...page.hero} />

  <div class="shell pb-20 lg:pb-28">
    <Gallery client:load initialItems={items} copy={t.gallery} showFilters />
  </div>

  <Contact {...page.cta} />
</Site>
