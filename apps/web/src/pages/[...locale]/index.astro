---
import Site from "@/layouts/Site.astro";
import Hero from "@/components/sections/Hero.astro";
import ServicesList from "@/components/sections/ServicesList.astro";
import FeaturedWork from "@/components/sections/FeaturedWork.astro";
import Process from "@/components/sections/Process.astro";
import ServiceArea from "@/components/sections/ServiceArea.astro";
import Contact from "@/components/sections/Contact.astro";
import { i18n } from "@/services/i18n";
import { localeParams } from "@/services/locale";

/**
 * Pages in this folder build once per language: `/` and `/es`. The route's
 * `[...locale]` segment is the language prefix (empty for English), and every
 * component below reads `Astro.currentLocale` for its copy.
 */
export const getStaticPaths = () => localeParams();

const { t } = i18n(Astro.currentLocale);
---

<Site title={t.home.title} description={t.description}>
  <Hero />
  <ServicesList />
  <FeaturedWork />
  <Process />
  <ServiceArea />
  <Contact />
</Site>
