---
import Site from "@/layouts/Site.astro";
import Contact from "@/components/sections/Contact.astro";
import FaqList from "@/components/sections/FaqList.astro";
import PageIntro from "@/components/ui/PageIntro.astro";
import Section from "@/components/ui/Section.astro";
import { getFaqs, getServices } from "@/services/content";
import { i18n } from "@/services/i18n";
import { fill, localeParams } from "@/services/locale";

/** Builds `/services` and `/es/services`; see `[...locale]/index.astro`. */
export const getStaticPaths = () => localeParams();

const { locale, t, href } = i18n(Astro.currentLocale);
const page = t.servicesPage;
const services = await getServices(locale);
const faqs = await getFaqs(locale);

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<Site title={page.title} description={page.description} jsonLd={faqJsonLd}>
  <PageIntro {...page.hero} />

  {
    services.map((service) => (
      <Section id={service.id} title={service.title} lead={service.tagline}>
        <p class="max-w-[62ch] text-xl leading-relaxed text-taupe-950">
          {service.description}
        </p>
        <ul class="mt-8 grid gap-x-10 gap-y-2 border-t border-taupe-200 pt-6 text-lg leading-relaxed text-taupe-700 sm:grid-cols-2">
          {service.features.map((feature) => (
            <li class="flex gap-3">
              <span class="text-taupe-400" aria-hidden="true">
                –
              </span>
              {feature}
            </li>
          ))}
        </ul>
        <a
          href={href(`/gallery?category=${service.category}`)}
          class="mt-8 inline-block text-lg text-taupe-700 underline decoration-taupe-300 transition-colors hover:text-taupe-950 hover:decoration-taupe-700"
        >
          {fill(page.seeBuilt, { service: service.title.toLowerCase() })}
        </a>
      </Section>
    ))
  }

  <Section {...page.faq}>
    <FaqList items={faqs} />
  </Section>

  <Contact />
</Site>
