---
import { Check } from "lucide-react";
import Site from "@/layouts/Site.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import FaqList from "@/components/sections/FaqList.astro";
import Icon from "@/components/ui/Icon.astro";
import PageHero from "@/components/ui/PageHero.astro";
import Reveal from "@/components/ui/Reveal.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { cn } from "@/components/ui/cn";
import { getFaqs, getServices } from "@/services/content";
import { i18n } from "@/services/i18n";
import { fill, localeParams } from "@/services/locale";

/** Builds `/services` and `/es/services`; see `[...locale]/index.astro`. */
export const getStaticPaths = () => localeParams();

const { locale, t, href } = i18n(Astro.currentLocale);
const page = t.servicesPage;
const services = await getServices(locale);
const faqs = await getFaqs(locale);

// Swatch gradients in the mark's greys that pair with each service panel
// until the client's own photos take their place.
const swatches = [
  ["#D9D5D2", "#BCB7B4"],
  ["#4C4441", "#2A2523"],
  ["#9E9997", "#756C69"],
  ["#F5F3F1", "#D9D5D2"],
  ["#BCB7B4", "#9E9997"],
  ["#635956", "#3A3331"],
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<Site title={page.title} description={page.description} jsonLd={faqJsonLd}>
  <PageHero {...page.hero} />

  <div class="bg-paper">
    <div class="shell flex flex-col gap-24 py-20 lg:gap-28 lg:py-28">
      {
        services.map((service, i) => {
          const [from, to] = swatches[i % swatches.length]!;
          const flip = i % 2 === 1;
          return (
            <Reveal
              id={service.id}
              class="grid scroll-mt-28 items-center gap-10 lg:grid-cols-2 lg:gap-16"
            >
              <div
                class={cn(
                  "relative order-first aspect-[5/4] overflow-hidden rounded-tile border border-taupe-900/10 shadow-paver",
                  flip && "lg:order-last",
                )}
                style={`background-image: linear-gradient(135deg, ${from}, ${to});`}
              >
                <div class="absolute inset-0 herringbone opacity-25 mix-blend-overlay" />
                <span class="absolute bottom-5 left-5 rounded-tile bg-white/90 px-3 py-1.5 eyebrow text-taupe-900">
                  {service.tagline}
                </span>
              </div>

              <div class="flex flex-col gap-5">
                <div class="flex items-center gap-4">
                  <span class="flex h-12 w-12 items-center justify-center rounded-tile bg-taupe-900 text-white">
                    <Icon name={service.icon} class="h-5 w-5" />
                  </span>
                  <span class="eyebrow text-taupe-500">
                    {String(service.order).padStart(2, "0")} / {service.tagline}
                  </span>
                </div>
                <h2 class="text-3xl sm:text-4xl">{service.title}</h2>
                <p class="max-w-xl leading-relaxed text-taupe-900/70">
                  {service.description}
                </p>
                <ul class="mt-2 grid gap-3 sm:grid-cols-2">
                  {service.features.map((feature) => (
                    <li class="flex items-start gap-2.5 text-sm text-taupe-900/80">
                      <Check
                        className="mt-0.5 h-4 w-4 shrink-0 text-taupe-700"
                        strokeWidth={2.4}
                      />
                      {feature}
                    </li>
                  ))}
                </ul>
                <a
                  href={href(`/gallery?category=${service.category}`)}
                  class="mt-2 eyebrow text-taupe-700 hover:text-taupe-950"
                >
                  {fill(page.seeBuilt, {
                    service: service.title.toLowerCase(),
                  })}
                </a>
              </div>
            </Reveal>
          );
        })
      }
    </div>
  </div>

  <section class="bg-taupe-50">
    <div class="shell grid gap-12 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:py-28">
      <SectionHeading {...page.faq} />
      <FaqList items={faqs} />
    </div>
  </section>

  <CtaBand />
</Site>
