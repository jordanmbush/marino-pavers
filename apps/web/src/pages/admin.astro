---
import Base from "@/layouts/Base.astro";
import Logo from "@/components/site/Logo.astro";
import { AdminApp } from "@/components/admin/AdminApp";
---

<Base
  title="Photo library — Marino Pavers"
  description="Manage the photos shown on marinopavers.com."
  noindex
>
  <div class="flex min-h-screen flex-col bg-paper text-taupe-900">
    <header class="border-b border-taupe-900/10 bg-paper/85">
      <div class="shell flex h-[4.5rem] items-center justify-between">
        <Logo />
        <a
          href="/gallery"
          class="eyebrow text-taupe-900/60 hover:text-taupe-900"
          >View the site →</a
        >
      </div>
    </header>
    <main class="flex-1">
      <AdminApp client:only="react" />
    </main>
  </div>
</Base>
