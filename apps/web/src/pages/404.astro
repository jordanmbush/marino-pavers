---
import Site from "@/layouts/Site.astro";
import Button from "@/components/ui/Button.astro";
import { DEFAULT_LOCALE, LOCALES } from "@/content/locales";
import { nav } from "@/content/site";
import { i18n } from "@/services/i18n";
import { alternatesOf } from "@/services/locale";

/**
 * One 404 for the whole site: CloudFront serves this file for any missing
 * key, whichever language the URL was in. So the page carries its copy in
 * every language, shows English by default, and a small script reveals the
 * language the URL asked for. The head and the chrome stay English — the
 * page is noindex, so nothing here is for search engines — and the language
 * switcher offers each home page rather than a mirrored `/es/404`.
 */
const english = i18n(DEFAULT_LOCALE).t.notFound;
const versions = LOCALES.map((locale) => i18n(locale));
---

<Site
  title={english.title}
  description={english.description}
  alternates={alternatesOf("/")}
  noindex
>
  {
    versions.map(({ locale, t, href }) => (
      <section
        data-locale={locale}
        lang={locale}
        hidden={locale !== DEFAULT_LOCALE}
        class="shell flex min-h-[60vh] flex-col items-start justify-center gap-8 py-24"
      >
        <h1 class="max-w-[14ch] text-[3rem] leading-[1.02] text-taupe-950 sm:text-[3.75rem] lg:text-[4.5rem]">
          {t.notFound.heading}
        </h1>
        <p class="max-w-[50ch] text-xl leading-relaxed text-taupe-700">
          {t.notFound.lead}
        </p>
        <Button href={href("/")} size="lg">
          {t.notFound.back}
        </Button>
        <nav
          class="mt-4 flex flex-wrap gap-x-8 gap-y-2 border-t border-taupe-200 pt-6 text-lg"
          aria-label={t.notFound.pages}
        >
          {nav.map((item) => (
            <a
              href={href(item.href)}
              class="text-taupe-700 underline decoration-taupe-300 hover:text-taupe-950 hover:decoration-taupe-700"
            >
              {t.nav[item.id]}
            </a>
          ))}
        </nav>
      </section>
    ))
  }
</Site>

<script>
  import { DEFAULT_LOCALE } from "@/content/locales";
  import { splitLocale } from "@/services/locale";

  // Show the language the missing URL was in: `/es/anything` reads Spanish.
  const { locale } = splitLocale(location.pathname);
  if (locale !== DEFAULT_LOCALE) {
    document.documentElement.lang = locale;
    for (const section of document.querySelectorAll<HTMLElement>(
      "[data-locale]",
    )) {
      section.hidden = section.dataset.locale !== locale;
    }
  }
</script>
