---
import { Clock, Mail, MapPin, Phone } from "lucide-react";
import Site from "@/layouts/Site.astro";
import Button from "@/components/ui/Button.astro";
import PageHero from "@/components/ui/PageHero.astro";
import { serviceAreas, site } from "@/content/site";

/**
 * No form, by design: the site has no backend to receive one, and a mailto
 * handoff half-works at best. Every way to reach the crew is a real link.
 */
const emailSubject = encodeURIComponent("Quote request — paver project");
const quoteHref = `${site.emailHref}?subject=${emailSubject}`;

const next = [
  "We call or email within one business day.",
  "We schedule a free on-site walkthrough with samples.",
  "You get a clear, itemized quote — no pressure.",
];
---

<Site
  title="Contact — Get a Free Paver Quote | Marino Pavers"
  description={`Call ${site.phoneDisplay} or email ${site.email} for a free on-site quote on paver patios, driveways, pool decks and turf anywhere in greater Phoenix.`}
>
  <PageHero
    eyebrow="Contact"
    title="Let’s talk about your yard."
    lead="Tell us what you’re picturing and we’ll come measure, bring samples, and leave you with an honest, itemized quote — free."
  />

  <section class="bg-sand">
    <div
      class="shell grid gap-12 py-20 lg:grid-cols-[1.3fr_1fr] lg:gap-16 lg:py-28"
    >
      <div
        class="rounded-tile border border-basalt/10 bg-bone p-7 shadow-paver sm:p-10"
      >
        <span class="eyebrow text-cherokee">Reach us directly</span>
        <a
          href={site.phoneHref}
          class="mt-4 block font-display-wide text-4xl font-extrabold text-basalt transition-colors hover:text-cherokee sm:text-5xl"
        >
          {site.phoneDisplay}
        </a>
        <p class="mt-3 max-w-md leading-relaxed text-basalt/70">
          Call or text during business hours and you’ll get a person, not a
          menu. Prefer to write? Email us a few photos of the space and what you
          have in mind.
        </p>

        <ul class="mt-8 flex flex-col gap-4 text-basalt/80">
          <li>
            <a
              href={site.emailHref}
              class="flex items-center gap-4 hover:text-cherokee"
            >
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-tile bg-basalt text-bone"
              >
                <Mail className="h-5 w-5" />
              </span>
              {site.email}
            </a>
          </li>
          <li class="flex items-center gap-4">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-tile bg-basalt text-bone"
            >
              <MapPin className="h-5 w-5" />
            </span>
            {site.address.region}
          </li>
          <li class="flex items-center gap-4">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-tile bg-basalt text-bone"
            >
              <Clock className="h-5 w-5" />
            </span>
            {site.hours}
          </li>
        </ul>

        <div class="mt-8 flex flex-wrap gap-4">
          <Button href={site.phoneHref} size="lg">
            <Phone className="h-4 w-4" strokeWidth={2.4} />
            Call {site.phoneDisplay}
          </Button>
          <Button href={quoteHref} variant="outline" size="lg">
            <Mail className="h-4 w-4" strokeWidth={2.4} />
            Email for a quote
          </Button>
        </div>
      </div>

      <div class="flex flex-col gap-8">
        <div class="rounded-tile border border-basalt/10 bg-sand-light p-7">
          <h3 class="eyebrow text-cherokee">What happens next</h3>
          <ol class="mt-4 flex flex-col gap-4">
            {
              next.map((step, i) => (
                <li class="flex gap-3 text-sm text-basalt/75">
                  <span class="font-mono font-bold text-cherokee">
                    0{i + 1}
                  </span>
                  {step}
                </li>
              ))
            }
          </ol>
        </div>

        <div class="flex flex-col gap-3">
          <h3 class="eyebrow text-basalt/60">Where we work</h3>
          <p class="text-sm leading-relaxed text-basalt/70">
            {serviceAreas.join(" · ")}
          </p>
        </div>

        <p class="font-mono text-xs text-basalt/50">
          Licensed · Bonded · Insured — {site.license}
        </p>
      </div>
    </div>
  </section>
</Site>
